<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS y solo certificados del sistema. La red solo se usa para bajar el catálogo y los modelos (GitHub). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
