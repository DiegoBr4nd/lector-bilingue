+
+// Bounded reader over the mapped model file. Invariant: pos_ <= size_.
+// Every read checks that it fits in what is left of the file (with overflow
+// checks on count * sizeof(Element)), so a truncated or corrupt file throws
+// instead of reading past the end of the mapping.
+class Reader {
+ public:
+  Reader(void* data, size_t size)
+      : base_(static_cast<char*>(data)), size_(data == nullptr ? 0 : size) {}
+
+  template <typename Element>
+  Element* emit(uint64_t count = 1) {
+    uint64_t bytes = 0;
+    if (__builtin_mul_overflow(count, sizeof(Element), &bytes) ||
+        bytes > size_ - pos_) {
+      corrupt();
+    }
+    char* begin = base_ + pos_;
+    pos_ += bytes;
+    return reinterpret_cast<Element*>(begin);
+  }
+
+  // Scalars are copied out: their offset in the file may be unaligned.
+  uint64_t read_u64() {
+    uint64_t value = 0;
+    std::memcpy(&value, emit<char>(sizeof(uint64_t)), sizeof(uint64_t));
+    return value;
+  }
+
+  size_t position() const { return pos_; }
+
+ private:
+  char* base_;
+  size_t size_;
+  size_t pos_ = 0;
+};
+
+// shape.elements() * element_size + extra, with overflow checks. Negative
+// dimensions are rejected.
+uint64_t checked_bytes(const std::vector<int>& dims, uint64_t element_size,
+                       uint64_t extra) {
+  uint64_t elements = 1;
+  for (int dim : dims) {
+    if (dim < 0 ||
+        __builtin_mul_overflow(elements, static_cast<uint64_t>(dim),
+                               &elements)) {
+      corrupt();
+    }
+  }
+  uint64_t bytes = 0;
+  if (__builtin_mul_overflow(elements, element_size, &bytes) ||
+      __builtin_add_overflow(bytes, extra, &bytes)) {
+    corrupt();
+  }
+  return bytes;
 }
 
